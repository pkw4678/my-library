rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && request.auth.token.email_verified == true;
    }
    function approvedOwner(userId) {
      return isSelf(userId)
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved';
    }
    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();
      // Unverified applicants can create ONLY their own pending/member profile.
      // Immutable role/status/email/uid are enforced for self-updates.
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll(['uid','email','nickname','role','status','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','email','nickname','role','status','createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.createdAt is timestamp;
      // Status transitions are only possible for admins. This does not allow role elevation.
      allow update: if isAdmin()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt','updatedAt'])
        && request.resource.data.status in ['pending','approved','rejected','suspended']
        && request.resource.data.updatedAt is timestamp
        && (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt is timestamp);
      allow delete: if false;
      match /items/{itemId} {
        allow read: if approvedOwner(userId);
        allow create, update: if approvedOwner(userId)
          && request.resource.data.id == itemId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 180;
        allow delete: if approvedOwner(userId);
      }
      match /collections/{collectionId} {
        allow read: if approvedOwner(userId);
        allow create, update: if approvedOwner(userId)
          && request.resource.data.id == collectionId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 45;
        allow delete: if approvedOwner(userId);
      }
      match /trash/{itemId} {
        allow read: if approvedOwner(userId);
        allow create, update: if approvedOwner(userId)
          && request.resource.data.id == itemId
          && request.resource.data.item.id == itemId;
        allow delete: if approvedOwner(userId);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
